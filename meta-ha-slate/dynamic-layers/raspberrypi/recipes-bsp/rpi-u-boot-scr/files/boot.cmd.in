# HA Slate A/B boot (RAUC "uboot" bootloader backend).
# Partitions: 1=boot (vfat: firmware, u-boot, boot.scr, uboot.env)
#             2=rootfs A, 3=rootfs B (ext4, kernel in /boot), 4=data
# RAUC manipulates BOOT_ORDER and BOOT_<slot>_LEFT via fw_setenv.

# The RPi firmware has already merged config.txt overlays into the DTB and
# put the kernel command line in /chosen/bootargs.
fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv slot_part
setenv rauc_slot
for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${slot_part}" != "x"; then
    # already selected a slot
  elif test "x${BOOT_SLOT}" = "xA"; then
    if test ${BOOT_A_LEFT} -gt 0; then
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      setenv slot_part 2
      setenv rauc_slot A
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if test ${BOOT_B_LEFT} -gt 0; then
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      setenv slot_part 3
      setenv rauc_slot B
    fi
  fi
done

if test -z "${slot_part}"; then
  echo "slate: no bootable slot left, resetting attempt counters"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

saveenv
echo "slate: booting slot ${rauc_slot} (mmc 0:${slot_part})"
setenv bootargs "${bootargs} root=/dev/mmcblk0p${slot_part} rootfstype=ext4 rootwait ro rauc.slot=${rauc_slot} quiet"
load @@BOOT_MEDIA@@ 0:${slot_part} ${kernel_addr_r} /boot/@@KERNEL_IMAGETYPE@@
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
