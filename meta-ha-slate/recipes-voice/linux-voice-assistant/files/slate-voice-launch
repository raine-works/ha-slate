#!/bin/sh
# Start Linux Voice Assistant with HA Slate defaults.
# Settings: /etc/slate/voice.env, overridden by /data/slate/voice.env.
set -eu

STATE=/data/voice
APP=@LVA_PREFIX@/app
export PYTHONPATH=@LVA_SITE@

# Wake-word tree must be writable (HA can push downloaded models). Seed it
# from the read-only image on first boot, then refresh bundled models on
# every start so an OTA update ships new internal models.
mkdir -p "$STATE/wakewords/downloaded" "$STATE/wakewords/custom"
rm -rf "$STATE/wakewords/internal"
cp -R "$APP/wakewords/internal" "$STATE/wakewords/internal"

set -- --name "${SLATE_DEVICE_NAME:-ha-slate}" \
       --preferences-file "$STATE/preferences.json" \
       --wake-word-root-dir "$STATE/wakewords" \
       --audio-input-device "${VOICE_INPUT:-aec_mic}" \
       --audio-output-device "${VOICE_OUTPUT:-pulse/aec_sink}" \
       --wake-model "${VOICE_WAKE_MODEL:-okay_nabu}" \
       --peripheral-host 127.0.0.1 \
       --mic-auto-gain "${VOICE_AGC:-0}" \
       --mic-noise-suppression "${VOICE_NS:-0}"

if [ "${VOICE_ENCRYPTION:-1}" = "1" ]; then
    set -- "$@" --enable-encryption --encryption-key-file "$STATE/encryption.key"
fi
[ -n "${VOICE_INTERFACE:-}" ] && set -- "$@" --network-interface "$VOICE_INTERFACE"
[ "${VOICE_DEBUG:-0}" = "1" ] && set -- "$@" --debug

cd "$APP"
exec /usr/bin/python3 -m linux_voice_assistant "$@"
