# Voice satellite defaults. Override per-site in /data/slate/voice.env.
# PipeWire node names created by slate-audio's echo-cancel module:
VOICE_INPUT=aec_mic
VOICE_OUTPUT=pulse/aec_sink
VOICE_WAKE_MODEL=okay_nabu
# ESPHome API encryption: key generated into /data/voice on first start;
# paste it into HA when adopting the device.
VOICE_ENCRYPTION=1
# WebRTC AGC (0-31) and noise suppression (0-4) inside LVA. Leave at 0 when
# the PipeWire echo-cancel module already runs webrtc AGC/NS.
VOICE_AGC=0
VOICE_NS=0
VOICE_DEBUG=0
