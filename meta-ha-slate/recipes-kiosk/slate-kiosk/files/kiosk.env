# Default kiosk settings. Override per-site in /data/slate/kiosk.env.
# "?kiosk" is honoured by the kiosk-mode HACS card; harmless otherwise.
KIOSK_URL=http://homeassistant.local:8123/
# restart: respawn the WebProcess in place; exit: let systemd restart Cog.
KIOSK_ON_CRASH=restart
KIOSK_BG=#000000
# Logical-pixel scale; 1.5-2.0 for high-DPI 8"/10" panels.
KIOSK_SCALE=
KIOSK_IGNORE_TLS_ERRORS=0
