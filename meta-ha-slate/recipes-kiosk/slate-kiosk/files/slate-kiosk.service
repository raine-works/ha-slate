[Unit]
Description=HA Slate kiosk browser
# weston.service is Type=notify: we start only once its socket is serving.
Requires=weston.service
After=weston.service network-online.target slate-data-fallback.service
Wants=network-online.target
RequiresMountsFor=/data
# Crash-loop guard: after 10 failures in 5 min, stop and let the watchdog /
# a human look at it instead of flapping the GPU forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=wayland render video
EnvironmentFile=/etc/slate/kiosk.env
EnvironmentFile=-/data/slate/kiosk.env
# Highest precedence: the "Dashboard URL" entity in Home Assistant.
EnvironmentFile=-/data/agent/kiosk.env
Environment=WAYLAND_DISPLAY=/run/wayland-0
Environment=XDG_RUNTIME_DIR=/run/slate-kiosk
# WebKit stores cookies + localStorage (HA auth tokens!) under XDG_DATA_HOME.
Environment=XDG_DATA_HOME=/data/kiosk/data
Environment=XDG_CACHE_HOME=/data/kiosk/cache
Environment=COG_PLATFORM_WL_VIEW_FULLSCREEN=1
RuntimeDirectory=slate-kiosk
RuntimeDirectoryMode=0700
ExecStart=@LIBEXECDIR@/slate-kiosk-launch
Restart=always
RestartSec=2

# Sandboxing: the browser parses untrusted network content.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/kiosk
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Memory cap: a leaking dashboard must not starve the voice pipeline.
MemoryHigh=600M
MemoryMax=800M
OOMScoreAdjust=300

[Install]
WantedBy=graphical.target
